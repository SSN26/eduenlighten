{
  "name": "eduenlighten-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "EduEnlighten Digital School Platform - Monorepo",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "edtech",
    "digital-school",
    "cambridge",
    "zimsec",
    "digital-skills"
  ],
  "author": "EduEnlighten Team",
  "license": "ISC"
}
