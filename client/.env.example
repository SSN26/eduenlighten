# EduEnlighten Client Environment Variables

# Node runtime & port (Render uses port 10000 by default)
NODE_ENV=development
PORT=3000

# Backend REST API URL
# In local development: http://localhost:5001
# In production on Render: https://eduenlighten-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5001

# Disable Next.js telemetry in Docker / CI
NEXT_TELEMETRY_DISABLED=1
