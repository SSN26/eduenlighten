# EduEnlighten Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/eduenlighten

# JWT Authentication
JWT_SECRET=eduenlighten_jwt_secret_key_production_replace_this_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=eduenlighten_token

# Email Service (SMTP / Nodemailer)
EMAIL_SERVICE=console
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=demo_user
EMAIL_PASS=demo_pass
EMAIL_FROM="EduEnlighten Academy" <noreply@eduenlighten.ac>

# Video Conferencing Provider (jitsi / zoom / meet)
LIVE_CLASS_PROVIDER=jitsi

# Payment Gateway (mock / paynow / stripe)
PAYMENT_PROVIDER=mock_paynow
PAYNOW_INTEGRATION_ID=demo_paynow_id
PAYNOW_INTEGRATION_KEY=demo_paynow_key
PAYNOW_RESULT_URL=http://localhost:5000/api/payments/paynow/webhook
PAYNOW_RETURN_URL=http://localhost:3000/student/payment-success

# File Upload / Storage (local / s3 / cloudinary)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
