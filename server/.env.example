# ==================================================
# EduEnlighten Server Environment Variables
# ==================================================

# Server runtime (Render uses 10000, local dev defaults to 5001)
PORT=5001
NODE_ENV=development
NODE_VERSION=20.18.0

# Frontend Client URL (used for CORS and cookies)
# In local development: http://localhost:3000
# In production on Render: https://eduenlighten-web.onrender.com
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# In local development: mongodb://127.0.0.1:27017/eduenlighten
# In production (e.g. MongoDB Atlas):
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/eduenlighten?retryWrites=true&w=majority
# NOTE: In MongoDB Atlas Network Access, add 0.0.0.0/0 to allow connections from Render.
MONGODB_URI=mongodb://127.0.0.1:27017/eduenlighten

# JWT Authentication (at least 32 characters)
JWT_SECRET=eduenlighten_jwt_secret_key_production_replace_this_min_32_chars!
JWT_EXPIRES_IN=7d
COOKIE_NAME=eduenlighten_token

# AI Teacher Agents (Optional Google Gemini API key for dynamic LLM reasoning)
# If omitted, EduEnlighten's built-in pedagogical knowledge engine responds automatically.
GEMINI_API_KEY=

# Email Service (console / smtp)
EMAIL_SERVICE=console
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=demo_user
EMAIL_PASS=demo_pass
EMAIL_FROM="EduEnlighten Academy" <noreply@eduenlighten.ac>

# Video Conferencing Provider (jitsi / zoom / meet)
LIVE_CLASS_PROVIDER=jitsi

# Payment Gateway (mock_paynow / paynow / stripe)
PAYMENT_PROVIDER=mock_paynow
PAYNOW_INTEGRATION_ID=demo_paynow_id
PAYNOW_INTEGRATION_KEY=demo_paynow_key
PAYNOW_RESULT_URL=http://localhost:5001/api/payments/paynow/webhook
PAYNOW_RETURN_URL=http://localhost:3000/student/payment-success

# File Upload / Storage (local / s3 / cloudinary)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
